{
  "id": "odoo-erp",
  "name": "odoo-erp",
  "display_name": "Odoo ERP Integration",
  "version": "1.0.0",
  "description": "Multitenant Odoo ERP integration for farm and energy community management. Includes Som Comunitats modules for solar installations and energy self-consumption projects.",
  "description_i18n": {
    "es": "Integración Odoo ERP multitenant para gestión de fincas y comunidades energéticas. Incluye módulos Som Comunitats para instalaciones solares y proyectos de autoconsumo energético.",
    "en": "Multitenant Odoo ERP integration for farm and energy community management. Includes Som Comunitats modules for solar installations and energy self-consumption projects.",
    "eu": "Odoo ERP multi-tenant integrazioa baserri eta energia-komunitateen kudeaketarako. Som Comunitats moduluak barne eguzki-instalazioetarako eta energia-autokontsumo proiektuetarako.",
    "fr": "Intégration Odoo ERP multi-tenant pour la gestion des fermes et des communautés énergétiques. Inclut les modules Som Comunitats pour les installations solaires et les projets d'autoconsommation énergétique.",
    "pt": "Integração Odoo ERP multitenant para gestão de fazendas e comunidades energéticas. Inclui módulos Som Comunitats para instalações solares e projetos de autoconsumo energético.",
    "ca": "Integració Odoo ERP multitenant per a gestió de finques i comunitats energètiques. Inclou mòduls Som Comunitats per a instal·lacions solars i projectes d'autoconsum energètic."
  },
  "category": "integration",
  "module_type": "ADDON_PAID",
  "required_plan_type": "premium",
  "pricing_tier": "PAID",

  "author": {
    "name": "Kate Benetis",
    "email": "kate@robotika.cloud",
    "company": "Robotika",
    "website": "https://robotika.cloud"
  },

  "icon": "building-2",
  "icon_url": "/modules/odoo-erp/assets/icon.png",
  "company_logo_url": "/modules/odoo-erp/assets/robotika-logo.png",

  "route_path": "/odoo",
  "accent": {
    "base": "#6366F1",
    "soft": "#E0E7FF",
    "strong": "#4338CA"
  },
  "label": "Odoo ERP",
  "navigation": {
    "enabled": true,
    "priority": 30,
    "section": "management"
  },

  "required_roles": ["TenantAdmin", "PlatformAdmin", "Manager"],

  "dependencies": {
    "sdk_version": "^1.0.0",
    "react_version": "^18.3.1",
    "platform_version": "^2.0.0"
  },

  "permissions": {
    "api_access": [
      "/api/odoo/*",
      "/api/odoo/tenant/*",
      "/api/odoo/sync/*",
      "/api/odoo/webhook/*"
    ],
    "storage_access": true,
    "external_requests": []
  },
  "_comment_external_requests": "If the platform restricts external origins, configure your Odoo host (e.g. odoo.YOUR_DOMAIN) in the platform CORS/allowlist; no domain is hardcoded here.",

  "build_config": {
    "type": "iife",
    "remote_entry_url": "/modules/odoo-erp/nkz-module.js"
  },

  "slots": {
    "layer-toggle": [],
    "context-panel": [
      {
        "id": "odoo-entity-link",
        "component": "OdooEntityLink",
        "priority": 60,
        "tab": "ERP",
        "showWhen": {
          "entityType": ["AgriParcel", "Device", "Building"]
        }
      },
      {
        "id": "odoo-status-widget",
        "component": "OdooStatusWidget",
        "priority": 70,
        "tab": "ERP",
        "showWhen": {
          "entityType": ["AgriParcel", "Device", "Building"]
        }
      }
    ],
    "bottom-panel": [],
    "entity-tree": [
      {
        "id": "odoo-quick-actions",
        "component": "OdooQuickActions",
        "priority": 50
      }
    ],
    "map-layer": []
  },

  "integrations": {
    "n8n": {
      "enabled": true,
      "webhooks": [
        "odoo.invoice.created",
        "odoo.order.confirmed",
        "odoo.energy.production"
      ]
    },
    "intelligence": {
      "enabled": true,
      "features": [
        "yield_prediction_to_odoo",
        "energy_forecast_to_odoo"
      ]
    },
    "ngsi_ld": {
      "enabled": true,
      "subscriptions": [
        "AgriParcel",
        "Device",
        "Building",
        "EnergyMeter"
      ]
    }
  },

  "odoo_config": {
    "version": "16.0",
    "multitenancy": "multi-db",
    "energy_modules": [
      "energy_community",
      "energy_selfconsumption",
      "energy_import_statement"
    ]
  },

  "metadata": {
    "icon": "🏢",
    "color": "#714B67",
    "features": [
      "Multitenant Odoo ERP (one DB per tenant)",
      "Farm management (products, parcels, harvests)",
      "Solar installation management",
      "Energy self-consumption tracking",
      "Invoicing and accounting",
      "CRM and inventory",
      "N8N workflow automation",
      "AI-powered predictions integration"
    ],
    "screenshots": [
      "assets/screenshot-dashboard.png",
      "assets/screenshot-energy.png",
      "assets/screenshot-farm.png"
    ],
    "documentation_url": "https://github.com/nkz-os/nkz-module-odoo#readme"
  },
  "surfaces": {
    "web": {
      "slots": {
        "context-panel": [
          {
            "id": "odoo-entity-link",
            "component": "OdooEntityLink",
            "priority": 60,
            "tab": "ERP",
            "showWhen": {
              "entityType": ["AgriParcel", "Device", "Building"]
            }
          },
          {
            "id": "odoo-status-widget",
            "component": "OdooStatusWidget",
            "priority": 70,
            "tab": "ERP",
            "showWhen": {
              "entityType": ["AgriParcel", "Device", "Building"]
            }
          }
        ],
        "entity-tree": [
          {
            "id": "odoo-quick-actions",
            "component": "OdooQuickActions",
            "priority": 50
          }
        ],
        "layer-toggle": [],
        "bottom-panel": [],
        "map-layer": []
      }
    }
  }
}
